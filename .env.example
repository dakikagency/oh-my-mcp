# ---- Database (Neon Postgres) ----
# Pooled connection string (used at runtime via @neondatabase/serverless)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection for Prisma migrate / introspection
DIRECT_URL="postgresql://user:password@ep-xxx.region.neon.tech/neondb?sslmode=require"

# ---- Auth (better-auth) ----
# 32-byte random string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- OAuth providers (optional) ----
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Crypto ----
# 32 bytes base64 — used to AES-GCM encrypt per-server API keys.
# `openssl rand -base64 32`
ENCRYPTION_KEY=""
